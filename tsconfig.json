{
  // The package's sources run in a Worker and its tests under Bun. Bun's types
  // carry the web globals the sources use (fetch's AbortSignal) as well as
  // bun:test, so one program covers the sources and the tests without a
  // dependency on any Worker type package: the sources declare the shapes they
  // read, and an app's own runtime values satisfy them.
  //
  // rootDir is the package boundary. tsc refuses any source file the program
  // reaches outside src/ (TS6059), so an import from an app, by relative path
  // or through a package link, fails the typecheck.
  //
  // The opt-in strictness flags are on so an app with the same flags can
  // typecheck these sources as part of its own program, which it does, since
  // the package ships TypeScript source.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
